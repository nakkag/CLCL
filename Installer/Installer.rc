LANGUAGE LANG_GERMAN, SUBLANG_GERMAN

STRINGTABLE
BEGIN
    IDS_SETUP_TITLE         "CLCL Setup"
    IDS_UNINSTALL_TITLE     "CLCL deinstallieren"
    IDS_HEADER              "CLCL Ver %s"
    IDS_DESC_INSTALL        "CLCL wird auf Ihrem Computer installiert.\nWählen Sie den Zielordner und die Optionen, und klicken Sie dann auf [Installieren]."
    IDS_DESC_UPDATE         "CLCL ist bereits installiert.\nPrüfen Sie den Zielordner und die Optionen, und klicken Sie dann auf [Aktualisieren]."
    IDS_DESC_COMPLETE       "CLCL wurde erfolgreich installiert."
    IDS_FOLDER              "&Zielordner:"
    IDS_BROWSE              "&Durchsuchen..."
    IDS_CHECK_STARTUP       "Zum Windows-&Autostart hinzufügen"
    IDS_CHECK_STARTMENU     "Verknüpfung im Start&menü erstellen"
    IDS_CHECK_DESKTOP       "Verknüpfung auf dem &Desktop erstellen"
    IDS_CHECK_RUN           "CLCL &starten"
    IDS_BUTTON_INSTALL      "&Installieren"
    IDS_BUTTON_UPDATE       "&Aktualisieren"
    IDS_BUTTON_CANCEL       "Abbrechen"
    IDS_BUTTON_FINISH       "&Fertig stellen"
    IDS_SELECT_FOLDER       "Wählen Sie den Zielordner."
    IDS_STATUS_EXTRACT      "Dateien werden kopiert..."
    IDS_STATUS_SHORTCUT     "Verknüpfungen werden erstellt..."
    IDS_STATUS_REGIST       "Anwendung wird registriert..."
    IDS_CONFIRM_CANCEL      "Möchten Sie die Installation abbrechen?"
    IDS_CONFIRM_UNINSTALL   "CLCL wird deinstalliert.\nSind Sie sicher?"
    IDS_CONFIRM_DELETE_DATA "Sollen auch die Einstellungen und der Verlauf gelöscht werden?"
    IDS_UNINSTALL_COMPLETE  "CLCL wurde erfolgreich deinstalliert."
    IDS_ERR_PATH_EMPTY      "Geben Sie den Zielordner an."
    IDS_ERR_PAYLOAD         "Die zu installierenden Dateien konnten nicht gelesen werden."
    IDS_ERR_CREATE_DIR      "Der Ordner konnte nicht erstellt werden.\n%s"
    IDS_ERR_EXTRACT         "Die Datei konnte nicht entpackt werden.\n%s"
    IDS_ERR_REGIST          "Die Anwendung konnte nicht registriert werden."
    IDS_ERR_NOT_INSTALLED   "CLCL ist nicht installiert."
    IDS_ERR_RUN             "CLCL konnte nicht gestartet werden."
    IDS_RUNNING             "CLCL wird ausgeführt.\nBeenden Sie CLCL, und klicken Sie dann auf [Wiederholen]."
    IDS_FILE_LOCKED         "Die Datei konnte nicht aktualisiert werden.\n%s\n\nFalls CLCL ausgeführt wird, beenden Sie CLCL und klicken Sie dann auf [Wiederholen]."
    IDS_ERR_PATH_INVALID    "Geben Sie den Zielordner als absoluten Pfad an, der mit einem Laufwerksbuchstaben (C:\\...) oder \\\\Server\\Freigabe beginnt.\nDer Pfad darf keine ..-Elemente enthalten."
    IDS_ERR_PATH_ROOT       "CLCL kann nicht direkt im Stammverzeichnis eines Laufwerks oder einer Freigabe installiert werden.\nGeben Sie einen Unterordner an."
    IDS_ERR_PATH_LONG       "Der Pfad des Zielordners ist zu lang."
    IDS_ERR_PATH_UNSAFE     "Der Zielordner kann nicht verwendet werden, da Standardbenutzer ihn ändern können.\n%s\nGeben Sie einen anderen Ordner an."
    IDS_CONFIRM_PATH_NETWORK "Bei einem Ordner im Netzwerk kann nicht überprüft werden, ob Standardbenutzer ihn nicht ändern können.\nFalls doch, könnte CLCL ersetzt werden.\nMöchten Sie die Installation fortsetzen?"
    IDS_ERR_UNINSTALL_START "Der Deinstaller konnte nicht vorbereitet werden.\nDie Datei konnte im temporären Ordner nicht erstellt oder nicht gestartet werden."
END

