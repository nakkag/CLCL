// Ukrainian resources

LANGUAGE LANG_UKRAINIAN, SUBLANG_DEFAULT

STRINGTABLE
BEGIN
    IDS_SETUP_TITLE         "Встановлення CLCL"
    IDS_UNINSTALL_TITLE     "Видалення CLCL"
    IDS_HEADER              "CLCL Ver %s"
    IDS_DESC_INSTALL        "CLCL буде встановлено на ваш комп'ютер.\nВиберіть папку призначення та параметри, потім натисніть [Встановити]."
