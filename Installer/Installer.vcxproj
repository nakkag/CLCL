  <!--
    prepare.ps1 に渡す追加の設定。msbuild の /p: で上書きできる。
    ClclOutDir には Release 構成のインストーラだけを出力する。
    Debug 構成の出力は Installer\Debug\CLCLInst.exe のみ。
    フォルダは末尾に \ を付けないこと (コマンドラインの引用符を壊すため)。
      ClclVersion    バージョン (既定: CLCL.rc の FILEVERSION)
      ClclSourceDir  インストールするファイルの収集元
      ClclOutDir     インストーラの出力先
  -->
  <PropertyGroup Label="ClclInstaller">
    <ClclOutDir Condition="'$(ClclOutDir)'==''">$(ProjectDir)out</ClclOutDir>
    <ClclExtraArgs Condition="'$(ClclVersion)'!=''">-Version "$(ClclVersion)"</ClclExtraArgs>
    <ClclPrepareArgs>$(ClclExtraArgs)</ClclPrepareArgs>
    <ClclPrepareArgs Condition="'$(ClclSourceDir)'!=''">$(ClclPrepareArgs) -SourceDir "$(ClclSourceDir)"</ClclPrepareArgs>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">
