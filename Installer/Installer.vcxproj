      <Command>powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$(ProjectDir)prepare.ps1" -Mode Publish -TargetPath "$(TargetPath)" -OutDir "$(ClclOutDir)" $(ClclExtraArgs)</Command>
